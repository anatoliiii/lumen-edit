#!/bin/sh
# Test double for `ssh`: accepts OpenSSH-style arguments and runs the remote
# command on this machine. Used by tests and for trying the remote mode
# without an SSH server: PATH=scripts/fake-ssh-dir:$PATH lumen-edit ssh://fake/path
master=0
check=""
sock=""
target=""
while [ $# -gt 0 ]; do
    case "$1" in
        -O) check="$2"; shift 2 ;;
        -S) sock="$2"; shift 2 ;;
        -o|-p|-i|-l|-F|-J|-L|-R|-D|-E|-b|-c|-m|-W) shift 2 ;;
        -M|-N) master=1; shift ;;
        -*) shift ;;
        *) target="$1"; shift; break ;;
    esac
done
# The master records its pid next to the socket so `-O check` reflects
# whether it is still running (killing it simulates a dropped link).
pidfile="$sock.fake"
if [ -n "$check" ]; then
    [ -f "$pidfile" ] || exit 0
    pid=$(cat "$pidfile")
    case "$check" in
        exit) kill "$pid" 2>/dev/null; rm -f "$pidfile"; exit 0 ;;
        *) kill -0 "$pid" 2>/dev/null; exit $? ;;
    esac
fi
if [ "$master" = 1 ] && [ $# -eq 0 ]; then
    echo "fake-ssh: connected to $target"
    [ -n "$sock" ] && echo $$ > "$pidfile"
    exec sleep 100000
fi
if [ $# -eq 0 ]; then
    exec "${SHELL:-/bin/sh}" -l
fi
exec sh -c "$*"
